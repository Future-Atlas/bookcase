{
  "scripts": {
    "test:api": "node --test test/api/*.test.js",
    "generate:legal-seo": "node scripts/generate-legal-seo-sources.mjs",
    "prepare:cloudflare": "npm run generate:legal-seo && node scripts/prepare-cloudflare-build.mjs",
