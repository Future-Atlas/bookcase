{
  "version": 2,
  "cleanUrls": true,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "build/web",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://adm.shinobi.jp https://*.shinobi.jp https://admax.cnobi.jp https://*.cnobi.jp; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; frame-src https:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "staging.sharemarium.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/book/nanji-hoshi-no-gotoku",
      "has": [
        {
          "type": "host",
          "value": "book-case-u9uq.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://www.sharemarium.com/book/9784065281499"
      }
    },
    {
      "src": "/book/nanji-hoshi-no-gotoku",
      "has": [
        {
          "type": "host",
          "value": "sharemariumbookcase.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://www.sharemarium.com/book/9784065281499"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "book-case-u9uq.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://www.sharemarium.com/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "sharemariumbookcase.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://www.sharemarium.com/$1"
      }
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap"
    },
    {
      "src": "/sitemap$",
      "status": 308,
      "headers": {
        "Location": "/sitemap.xml"
      }
    },
    {
      "src": "/user$",
      "status": 308,
      "headers": {
        "Location": "/users"
      }
    },
    {
      "src": "/user/(.*)",
      "status": 308,
      "headers": {
        "Location": "/users/$1"
      }
    },
    {
      "src": "/profile$",
      "status": 308,
      "headers": {
        "Location": "/users"
      }
    },
    {
      "src": "/profile/(.*)",
      "status": 308,
      "headers": {
        "Location": "/users/$1"
      }
    },
    {
      "src": "/posts$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Gg]ooglebot|Mediapartners-Google|Google-Display-Ads-Bot|[Bb]ingbot|[Yy]andex[Bb]ot|[Dd]uck[Dd]uck[Bb]ot|[Bb]aiduspider|[Tt]witterbot|[Ff]acebookexternalhit|[Ff]acebot|[Ll]inkedinbot|[Ee]mbedly|[Qq]uora|[Ss]lackbot).*"
        }
      ],
      "dest": "/api/posts-seo"
    },
    {
      "src": "/posts/([^/]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Gg]ooglebot|Mediapartners-Google|Google-Display-Ads-Bot|[Bb]ingbot|[Yy]andex[Bb]ot|[Dd]uck[Dd]uck[Bb]ot|[Bb]aiduspider|[Tt]witterbot|[Ff]acebookexternalhit|[Ff]acebot|[Ll]inkedinbot|[Ee]mbedly|[Qq]uora|[Ss]lackbot).*"
        }
      ],
      "dest": "/api/post-seo?post_id=$1"
    },
    {
      "src": "/(privacy|terms|community-guidelines|infringement-policy|external-transmission)$",
      "has": [
        {
          "type": "query",
          "key": "seo_preview",
          "value": "1"
        }
      ],
      "dest": "/api/legal-seo?path=$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "query",
          "key": "seo_preview",
          "value": "1"
        }
      ],
      "dest": "/api/seo-router?path=/$1"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Gg]ooglebot|Mediapartners-Google|Google-Display-Ads-Bot|[Bb]ingbot|[Yy]andex[Bb]ot|[Dd]uck[Dd]uck[Bb]ot|[Bb]aiduspider|[Tt]witterbot|[Ff]acebookexternalhit|[Ff]acebot|[Ll]inkedinbot|[Ee]mbedly|[Qq]uora|[Ss]lackbot).*"
        }
      ],
      "dest": "/api/seo-router?path=/"
    },
    {
      "src": "/(featured-books|genre/.*|book/.*|user/.*|users/.*|profile/.*|privacy|terms|community-guidelines|infringement-policy|external-transmission|contact|about)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Gg]ooglebot|Mediapartners-Google|Google-Display-Ads-Bot|[Bb]ingbot|[Yy]andex[Bb]ot|[Dd]uck[Dd]uck[Bb]ot|[Bb]aiduspider|[Tt]witterbot|[Ff]acebookexternalhit|[Ff]acebot|[Ll]inkedinbot|[Ee]mbedly|[Qq]uora|[Ss]lackbot).*"
        }
      ],
      "dest": "/api/seo-router?path=/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}
