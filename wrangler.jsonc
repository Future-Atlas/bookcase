{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sharemarium",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "assets": {
    "directory": "build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/sitemap",
      "/sitemap.xml",
      "/robots.txt",
      "/login",
      "/mypage",
      "/settings",
      "/help",
      "/moderation",
      "/posts",
      "/posts/*",
      "/featured-books",
      "/genre/*",
      "/book/*",
      "/user",
      "/user/*",
      "/users",
      "/users/*",
      "/profile",
      "/profile/*",
      "/privacy",
      "/terms",
      "/community-guidelines",
      "/infringement-policy",
      "/external-transmission",
      "/contact",
      "/about"
    ]
  },
  "env": {
    "staging": {
      "name": "sharemarium-staging",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "staging",
        "VERCEL_ENV": "preview",
        "RAKUTEN_REFERER": "https://staging.sharemarium.com/",
        "SEO_ENABLE_NDL_FALLBACK": "false"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "RAKUTEN_QUOTA",
            "class_name": "RakutenCoordinator"
          }
        ]
      },
      "migrations": [
        {
          "tag": "rakuten-app-quota-v1",
          "new_sqlite_classes": [
            "RakutenCoordinator"
          ]
        }
      ],
      "ratelimits": [
        {
          "name": "API_RATE_LIMIT",
          "namespace_id": "2626110211",
          "simple": {
            "limit": 120,
            "period": 60
          }
        },
        {
          "name": "CATALOG_RATE_LIMIT",
          "namespace_id": "2626110212",
          "simple": {
            "limit": 24,
            "period": 60
          }
        }
      ]
    },
    "production": {
      "name": "sharemarium-production",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "production",
        "VERCEL_ENV": "production",
        "RAKUTEN_REFERER": "https://www.sharemarium.com/",
        "SEO_ENABLE_NDL_FALLBACK": "false"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "RAKUTEN_QUOTA",
            "class_name": "RakutenCoordinator"
          }
        ]
      },
      "migrations": [
        {
          "tag": "rakuten-app-quota-v1",
          "new_sqlite_classes": [
            "RakutenCoordinator"
          ]
        }
      ],
      "ratelimits": [
        {
          "name": "API_RATE_LIMIT",
          "namespace_id": "2626110221",
          "simple": {
            "limit": 120,
            "period": 60
          }
        },
        {
          "name": "CATALOG_RATE_LIMIT",
          "namespace_id": "2626110222",
          "simple": {
            "limit": 24,
            "period": 60
          }
        }
      ]
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RAKUTEN_QUOTA",
        "class_name": "RakutenCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "rakuten-app-quota-v1",
      "new_sqlite_classes": [
        "RakutenCoordinator"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "2626110201",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "CATALOG_RATE_LIMIT",
      "namespace_id": "2626110202",
      "simple": {
        "limit": 24,
        "period": 60
      }
    }
  ]
}
