{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sharemarium",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "assets": {
    "directory": "build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/sitemap",
      "/sitemap.xml",
      "/robots.txt",
      "/posts",
      "/posts/*",
      "/featured-books",
      "/genre/*",
      "/book/*",
      "/user",
      "/user/*",
      "/users",
      "/users/*",
      "/profile",
      "/profile/*",
      "/privacy",
      "/terms",
      "/community-guidelines",
      "/infringement-policy",
      "/external-transmission",
      "/contact",
      "/about"
    ]
  },
  "env": {
    "staging": {
      "name": "sharemarium-staging",
      "vars": {
        "APP_ENV": "staging",
        "VERCEL_ENV": "preview",
        "RAKUTEN_REFERER": "https://staging.sharemarium.com/",
        "SEO_ENABLE_NDL_FALLBACK": "false"
      }
    },
    "production": {
      "name": "sharemarium-production",
      "vars": {
        "APP_ENV": "production",
        "VERCEL_ENV": "production",
        "RAKUTEN_REFERER": "https://www.sharemarium.com/",
        "SEO_ENABLE_NDL_FALLBACK": "false"
      }
    }
  }
}
